# Local mode requires an explicit password. Never commit .env.local.
RADAR_AUTH_MODE=local
RADAR_LOCAL_PASSWORD=
RADAR_SESSION_SECRET=
# Supabase mode: change RADAR_AUTH_MODE=supabase and set the following.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
RADAR_ALLOWED_EMAILS=
# Worker only. Never prefix service credentials with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Optional read-only public GitHub token (higher rate limits).
GITHUB_TOKEN=
